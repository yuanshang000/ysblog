# 依赖
node_modules/
.pnpm-store/

# 构建产物 —— 由 npm run build:vercel 生成，不应入库
dist/
dist-server/
apps/worker/public/admin/
apps/worker/public/islands/
apps/worker/public/assets/

# 本地开发数据（本地数据库文件、缓存、日志）
.tmp/
.wrangler/
.dev.vars

# 环境变量与密钥
# 规则说明：先忽略一切 env 家族文件（含 *.env.* 这类带前缀的变体），
# 再用 ! 放行唯一的示例文件。.env.local 内含真实数据库口令与 Vercel 令牌。
.env
.env.*
*.env
*.env.*
!.env.example
# 其它常见的密钥载体，一并忽略
*.pem
*.key
*.p12
*.pfx
secrets.json
service-account*.json

# Vercel
.vercel

# 日志与编辑器
*.log
npm-debug.log*
.DS_Store
.vscode/
.idea/

# 备份产物（可能含数据库导出与用户数据，不应入库）
backups/

# 调试用临时截图（README 用的正式截图在 docs/images/，需要入库）
.shots/
.shots
.env*.local
