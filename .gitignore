# 依赖
node_modules/
.pnpm-store/

# 构建产物 —— 由 CI 的 npm run build:ci 生成，不应入库
# （入库会导致仓库里的旧哈希文件与 CI 新构建的产物冲突）
dist/
apps/worker/public/admin/
apps/worker/public/islands/
apps/worker/public/assets/

# 本地开发数据（本地数据库文件、缓存、日志）
.tmp/
.wrangler/
.dev.vars

# 环境变量与密钥
.env
.env.*
!.env.example

# Vercel
.vercel

# 日志与编辑器
*.log
npm-debug.log*
.DS_Store
.vscode/
.idea/

# 备份产物（可能含数据库导出与用户数据，不应入库）
backups/

# 截图（调试用）
.shots/
