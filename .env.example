# 环境变量示例 —— 复制为 .env.local 并填入真实值
# .env.local 已被 .gitignore 忽略，不会误提交。
#
# Vercel 生产环境请在控制台的 Settings → Environment Variables 中配置同名变量。

# ---- 数据库（必填）----
# Vercel Postgres 控制台 → Database → 连接串，或用 `vercel env pull` 自动拉取
POSTGRES_URL="postgres://user:password@host/dbname?sslmode=require"
# 本地自建 Postgres 时可设为 false 以关闭 SSL 强制校验
POSTGRES_SSL="true"

# ---- 媒体存储（必填）----
# Vercel Blob：控制台 → Storage → 创建 Blob store 后自动生成
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
# 可选：给 Blob 配置自定义域名后填写，用于生成公开访问 URL
# BLOB_BASE_URL="https://cdn.example.com"

# ---- 安全密钥（必填，务必用随机值）----
# 生成方式：openssl rand -hex 32
# SESSION_SECRET 参与会话令牌哈希运算，泄露等同于可伪造会话
SESSION_SECRET="请替换为随机值"
# IP_HASH_SALT 保证统计数据中的 IP 哈希不可逆推
IP_HASH_SALT="请替换为随机值"

# ---- 可选 ----
# 首次创建管理员时需要；创建完成后建议删除该变量
# ADMIN_SETUP_TOKEN="一次性初始化令牌"

# Vercel Cron 会自动发送 Authorization: Bearer <CRON_SECRET>，用于校验定时任务请求
# 留空则退化为仅允许 Vercel Cron 的 User-Agent 访问
# CRON_SECRET="请替换为随机值"

# 站点公开地址，影响 RSS、Sitemap 与 canonical
SITE_URL="https://your-domain.vercel.app"
# 允许的后台来源，逗号分隔；留空则只用请求自身 origin
# ALLOWED_ORIGINS="https://your-domain.vercel.app"
MAX_UPLOAD_MB="10"
ALLOW_SVG="false"
ENVIRONMENT="production"