# 环境变量示例
# 复制为 .dev.vars（本地开发）或在 Cloudflare 控制台 / GitHub 中配置
#
# 注意：真实密钥请用 `wrangler secret put` 设置，不要提交到仓库。

# ===== 敏感密钥（必须用 Secret，绝不写入仓库）=====

# 会话令牌哈希盐。生成方式：openssl rand -hex 32
# 作用：参与会话 token 哈希，数据库泄露时防止 token 被还原
SESSION_SECRET=

# IP 哈希盐。生成方式：openssl rand -hex 32
# 作用：统计与限流的 IP 哈希，保证不可逆推
IP_HASH_SALT=

# 初始化令牌。首次创建管理员时使用，完成后用 `wrangler secret delete` 删除
ADMIN_SETUP_TOKEN=

# ===== 普通变量（可写入 wrangler.jsonc 的 vars）=====

# 站点公开地址，影响 canonical / OG / Sitemap / RSS
# 生产环境务必填写，如 https://blog.example.com
SITE_URL=

# 额外允许的后台来源（逗号分隔）。缺省时只允许请求自身的 origin
ALLOWED_ORIGINS=

# 单文件上传大小上限（MB），默认 10
MAX_UPLOAD_MB=10

# 是否允许上传 SVG。默认 false（SVG 可包含脚本，强烈建议保持关闭）
ALLOW_SVG=false

# 环境标识
ENVIRONMENT=production