{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myblog",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2024-12-05",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "apps/worker/public",
    "binding": "ASSETS",
    // Worker 优先：所有请求先进 Worker，由 Worker 精确分流
    // （静态文件透传 / SSR 渲染 / API / SPA 回退）。
    // 不启用 SPA 模式 —— 它会把所有未命中路径回退到根 index.html，
    // 而本项目根路径是 SSR 页面，没有根 index.html，会造成 /admin/* 拿不到内容。
    "run_worker_first": true,
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myblog",
      "database_id": "REPLACE_WITH_YOUR_D1_ID",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "myblog-media"
    }
  ],

  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    "ENVIRONMENT": "production",
    "SITE_URL": "",
    "ALLOWED_ORIGINS": "",
    "MAX_UPLOAD_MB": "10",
    "ALLOW_SVG": "false"
  },

  "env": {
    "staging": {
      "name": "myblog-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "myblog-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "myblog-media-staging"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "SITE_URL": "",
        "MAX_UPLOAD_MB": "5",
        "ALLOW_SVG": "false"
      }
    }
  }
}